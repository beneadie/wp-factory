# Copy to .env and fill in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: comma-separated chat IDs allowed to use the bot.
# Defaults to TELEGRAM_CHAT_ID when empty.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: model for `opencode run`.
OPENCODE_MODEL=

# Optional: commit identity for generated repos.
GIT_AUTHOR_NAME=site-factory
GIT_AUTHOR_EMAIL=factory@localhost

# Optional: where generated sites live. Defaults to ~/wp-factory-sites (ext4).
# Keep it off a Windows mount; node_modules and .next are much slower there.
SITES_ROOT=
