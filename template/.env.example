# WordPress origin, no trailing slash. Required.
WP_BASE_URL=https://example.com

# What this site is. `store` only when the origin exposes a Store API.
# Set by the factory before the first phase; do not guess.
SITE_MODE=content

# Visual template under templates/. The factory writes this at setup, or picks
# one from discovery evidence when it is unset. Do not guess.
TEMPLATE=

# Public site. Used for metadata and canonical URLs.
SITE_URL=http://localhost:3000
SITE_NAME=Example Site
SITE_DESCRIPTION=
SITE_LOCALE=en-IE
